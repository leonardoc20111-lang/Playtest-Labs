# ---------------------------------------------------------------------------
# Playtest Labs — environment
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------

# Backend mode is chosen automatically: Supabase is used when URL + anon key +
# database connection string are all present. Otherwise the bundled SQLite
# driver runs (BACKEND_MODE=local) so every workflow stays functional.
# SUPABASE_URL=https://yeotvkovscgtmsfdwsqv.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.yeotvkovscgtmsfdwsqv.supabase.co:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never exposed to the browser

# Local SQLite storage (default backend)
DATA_DIR=./data
DATABASE_PATH=./data/playtest.db

# Public URL used in notification links and password-reset emails
APP_URL=http://localhost:3000

# Seed accounts created on first boot (change the password in production)
ADMIN_EMAIL=admin@playtestlabs.gg
ADMIN_NAME=Playtest Labs Admin
ADMIN_PASSWORD=Playtest-Admin-Dev1!
DEMO_PASSWORD=PlaytestDemo123!

SUPPORT_EMAIL=hello@playtestlabs.gg
